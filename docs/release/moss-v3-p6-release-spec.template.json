{
  "schema_version": 1,
  "template_only": true,
  "replacement_rule": "Copy this file, set template_only to false, replace every __REQUIRED_* value, and add one files entry for every file under package, application, and moss_data roots.",
  "inventory_rule": "The package command rejects undeclared files in package, application, and moss_data roots. Every runtime DLL and license must therefore be listed, not only contract.json.",
  "release": {
    "version": "__REQUIRED_RELEASE_VERSION__",
    "git_commit": "__REQUIRED_FULL_40_HEX_RELEASE_COMMIT__",
    "platform": "windows-x86_64-vulkan",
    "architecture": "x86_64",
    "acceleration": "vulkan",
    "build_command": [
      "pnpm",
      "tauri:build:vulkan"
    ]
  },
  "policy": {
    "system_drive": "C:",
    "require_clean_tracked_tree": true,
    "complete_inventory_classifications": [
      "package",
      "application",
      "moss_data"
    ]
  },
  "roots": {
    "package": {
      "source": "__REQUIRED_SIGNED_INSTALLER_OUTPUT_DIRECTORY__",
      "classification": "package",
      "deployment_root": "D:\\MeetilyReleaseStaging"
    },
    "application": {
      "source": "__REQUIRED_INSTALLED_APPLICATION_DIRECTORY__",
      "classification": "application",
      "deployment_root": "C:\\Program Files\\Meetily"
    },
    "moss_data": {
      "source": "D:\\MeetilyData\\__REQUIRED_MOSS_MANIFEST_OWNED_SUBDIRECTORY__",
      "classification": "moss_data",
      "deployment_root": "D:\\MeetilyData\\__REQUIRED_MOSS_MANIFEST_OWNED_SUBDIRECTORY__"
    },
    "source": {
      "source": "__REQUIRED_CLEAN_RELEASE_CHECKOUT__",
      "classification": "source",
      "deployment_root": "SOURCE"
    },
    "evidence": {
      "source": "__REQUIRED_P6_EVIDENCE_DIRECTORY__",
      "classification": "evidence",
      "deployment_root": "EVIDENCE"
    }
  },
  "files": [
    {
      "id": "installer",
      "role": "installer",
      "root": "package",
      "path": "__REQUIRED_INSTALLER_RELATIVE_PATH__",
      "required": true
    },
    {
      "id": "installer-signature",
      "role": "installer_signature",
      "root": "package",
      "path": "__REQUIRED_INSTALLER_SIGNATURE_RELATIVE_PATH__",
      "required": true
    },
    {
      "id": "application-executable",
      "role": "application",
      "root": "application",
      "path": "Meetily.exe",
      "required": true
    },
    {
      "id": "moss-helper",
      "role": "moss_helper",
      "root": "application",
      "path": "moss-helper-x86_64-pc-windows-msvc.exe",
      "required": true
    },
    {
      "id": "llama-helper",
      "role": "llama_helper",
      "root": "application",
      "path": "llama-helper-x86_64-pc-windows-msvc.exe",
      "required": true
    },
    {
      "id": "ffmpeg",
      "role": "ffmpeg",
      "root": "application",
      "path": "ffmpeg-x86_64-pc-windows-msvc.exe",
      "required": true
    },
    {
      "id": "moss-model-q8",
      "role": "moss_model",
      "root": "moss_data",
      "path": "__REQUIRED_MOSS_Q8_MODEL_RELATIVE_PATH__",
      "required": true
    },
    {
      "id": "moss-runtime-contract",
      "role": "moss_runtime",
      "root": "moss_data",
      "path": "__REQUIRED_MOSS_RUNTIME_CONTRACT_RELATIVE_PATH__",
      "required": true
    },
    {
      "id": "moss-model-license",
      "role": "model_license",
      "root": "moss_data",
      "path": "__REQUIRED_MOSS_MODEL_LICENSE_RELATIVE_PATH__",
      "required": true
    },
    {
      "id": "moss-runtime-license",
      "role": "runtime_license",
      "root": "moss_data",
      "path": "__REQUIRED_MOSS_RUNTIME_LICENSE_RELATIVE_PATH__",
      "required": true
    },
    {
      "id": "moss-third-party-licenses",
      "role": "third_party_licenses",
      "root": "moss_data",
      "path": "__REQUIRED_MOSS_THIRD_PARTY_LICENSE_INDEX_RELATIVE_PATH__",
      "required": true
    },
    {
      "id": "database-migration",
      "role": "database_migration",
      "root": "source",
      "path": "__REQUIRED_DATABASE_MIGRATION_RELATIVE_PATH__",
      "required": true
    },
    {
      "id": "release-notes",
      "role": "release_notes",
      "root": "evidence",
      "path": "__REQUIRED_RELEASE_NOTES_RELATIVE_PATH__",
      "required": true
    },
    {
      "id": "authenticode-report",
      "role": "authenticode_report",
      "root": "evidence",
      "path": "__REQUIRED_AUTHENTICODE_REPORT_RELATIVE_PATH__",
      "required": true
    }
  ]
}
