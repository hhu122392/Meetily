{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "policyId": "meetily-windows-production-signing-v1",
  "product": {
    "displayName": "meetily",
    "identifier": "com.meetily.ai"
  },
  "authenticode": {
    "required": true,
    "verificationPolicy": "DefaultAuthenticode",
    "fileDigestAlgorithm": "SHA256",
    "codeSigningEkuOid": "1.3.6.1.5.5.7.3.3",
    "requireTrustedSignerChain": true,
    "requireTrustedTimestampChain": true,
    "requireTimestampCertificate": true,
    "approvedSignerSubjects": [
      "CN=Zackriya Solutions Private Limited, O=Zackriya Solutions Private Limited, L=Bengaluru, S=Karnataka, C=IN"
    ],
    "signerThumbprintSets": {
      "productionActive": [],
      "upstreamHistorical": [
        "0472869976D42A9F74D03B8B9CE60CF7A3983A3B"
      ]
    }
  },
  "roles": {
    "ProductionArtifact": {
      "signerThumbprintSet": "productionActive",
      "description": "The application binary or installer being published now."
    },
    "RecoveryInstaller": {
      "signerThumbprintSet": "productionActive",
      "description": "The current-version installer used to recover after a failed rollback."
    },
    "HistoricalRollbackTarget": {
      "signerThumbprintSet": "upstreamHistorical",
      "description": "An immutable upstream historical installer approved as a rollback target."
    }
  },
  "updater": {
    "required": true,
    "signatureFormat": "Tauri Ed25519/minisign",
    "publicKeyId": "ECA631D78797C82A",
    "publicKeyConfigPath": "frontend/src-tauri/tauri.conf.json",
    "privateKeyEnvironmentVariables": [
      "TAURI_SIGNING_PRIVATE_KEY",
      "TAURI_SIGNING_PRIVATE_KEY_PASSWORD"
    ],
    "requireDetachedSignature": true,
    "requireLatestJsonSignatureReference": true
  },
  "productionControls": {
    "failWhenProductionThumbprintSetIsEmpty": true,
    "forbidUnsignedOverride": true,
    "nonProductionUnsignedMode": "AuditUnsigned",
    "nonProductionUnsignedConfirmation": "I_UNDERSTAND_THIS_IS_NOT_FOR_RELEASE",
    "requireExplicitSmctlTimestamp": true,
    "requiredDigiCertEnvironmentVariables": [
      "SM_HOST",
      "SM_API_KEY",
      "SM_CLIENT_CERT_FILE",
      "SM_CLIENT_CERT_PASSWORD",
      "SM_CODE_SIGNING_CERT_SHA1_HASH",
      "DIGICERT_KEYPAIR_ALIAS"
    ]
  },
  "provenance": {
    "upstreamHistoricalArtifact": "meetily_0.3.0_x64-setup.exe",
    "upstreamHistoricalArtifactSha256": "900C10A4EA05D991A06AB670886DE45DE08904903298A862A94FDC66F25420D9",
    "policyFrozenAtUtc": "2026-08-24T00:00:00Z",
    "note": "productionActive is intentionally empty until the release owner approves the current publisher certificate subject and SHA-1 thumbprint in a reviewed policy change."
  }
}
