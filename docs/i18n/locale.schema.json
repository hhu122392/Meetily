{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meetily.local/schemas/locale.schema.json",
  "title": "Meetily locale bundle",
  "type": "object",
  "required": ["_meta"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["locale", "languageName", "direction"],
      "properties": {
        "$schema": { "type": "string" },
        "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        "languageName": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["ltr", "rtl"] },
        "generatedFrom": { "type": "string" },
        "warning": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": { "$ref": "#/$defs/translationNode" },
  "$defs": {
    "translationNode": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/translationNode" }
        }
      ]
    }
  }
}
