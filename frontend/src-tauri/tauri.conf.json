{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "meetily",
  "version": "0.4.3",
  "identifier": "com.meetily.ai",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3118",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "corepack pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "meetily",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "decorations": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: https://asset.localhost data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:11434 http://localhost:5167 http://localhost:8178 https://api.ollama.ai"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: https://asset.localhost data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:3118 ws://localhost:3118 http://localhost:11434 http://localhost:5167 http://localhost:8178 https://api.ollama.ai"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      },
      "capabilities": [
        {
          "identifier": "main",
          "description": "Main window capability with file system and media access",
          "windows": [
            "main"
          ],
          "permissions": [
            "fs:default",
            "fs:allow-read-file",
            "fs:read-all",
            "fs:write-all",
            "fs:allow-app-read",
            "fs:allow-app-write",
            "fs:allow-download-write",
            "fs:allow-download-read",
            "fs:scope-download",
            "core:path:default",
            "core:event:default",
            "core:window:default",
            "core:app:default",
            "core:resources:default",
            "core:menu:default",
            "core:tray:default",
            "core:window:allow-set-title",
            "store:default",
            "dialog:allow-open",
            "dialog:allow-save",
            "notification:default",
            "notification:allow-is-permission-granted",
            "updater:default",
            "process:default",
            {
              "identifier": "fs:scope",
              "allow": [
                {
                  "path": "$APPDATA/*"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.png",
      "icons/app_icon.icns",
      "icons/app_icon.ico"
    ],
    "resources": {
      "templates/en/*.json": "templates/en/",
      "templates/zh-CN/*.json": "templates/zh-CN/",
      "runtime/windows-x64/*.dll": "",
      "../../LICENSE.md": "licenses/Meetily-MIT.txt",
      "../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../licenses/*": "licenses/"
    },
    "externalBin": [
      "binaries/llama-helper",
      "binaries/moss-helper",
      "binaries/ffmpeg"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "runtime/webview2-fixed"
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "scripts/nsis-installer-template.nsi",
        "compression": "zlib",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "Meetily",
        "installerHooks": "scripts/nsis-installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
