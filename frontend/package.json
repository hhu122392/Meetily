{
  "name": "meetily",
  "version": "0.4.2",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --turbo -p 3118",
    "build": "next build",
    "export": "next export",
    "start": "next start -p 3118",
    "sidecars:prepare": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ../scripts/prepare-tauri-sidecars.ps1",
    "test:rust": "pnpm sidecars:prepare && cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "tauri:dev": "pnpm sidecars:prepare && node scripts/tauri-auto.js dev",
    "tauri:build": "pnpm sidecars:prepare && node scripts/tauri-auto.js build",
    "tauri:dev:cpu": "pnpm sidecars:prepare && tauri dev",
    "tauri:dev:cuda": "pnpm sidecars:prepare && tauri dev -- --features cuda",
    "tauri:dev:vulkan": "pnpm sidecars:prepare && tauri dev -- --features vulkan",
    "tauri:dev:metal": "pnpm sidecars:prepare && tauri dev -- --features metal",
    "tauri:dev:coreml": "pnpm sidecars:prepare && tauri dev -- --features coreml",
    "tauri:dev:openblas": "pnpm sidecars:prepare && tauri dev -- --features openblas",
    "tauri:dev:hipblas": "pnpm sidecars:prepare && tauri dev -- --features hipblas",
    "tauri:build:cpu": "pnpm sidecars:prepare && tauri build",
    "tauri:build:cuda": "pnpm sidecars:prepare && tauri build -- --features cuda",
    "tauri:build:vulkan": "pnpm sidecars:prepare && tauri build -- --features vulkan",
    "tauri:build:metal": "pnpm sidecars:prepare && tauri build -- --features metal",
    "tauri:build:coreml": "pnpm sidecars:prepare && tauri build -- --features coreml",
    "tauri:build:openblas": "pnpm sidecars:prepare && tauri build -- --features openblas",
    "tauri:build:hipblas": "pnpm sidecars:prepare && tauri build -- --features hipblas",
    "lint": "eslint src tests",
    "test:i18n": "tsx --test tests/i18n/*.test.ts tests/i18n/*.test.tsx",
    "test:moss": "tsx --test tests/moss/*.test.ts tests/moss/*.test.tsx",
    "test:i18n:phase2": "pnpm test:i18n && node ../docs/i18n/scripts/audit-phase2.mjs .. --batch=2A",
    "test:i18n:phase2:2b": "pnpm test:i18n && node ../docs/i18n/scripts/audit-phase2.mjs .. --batch=2B",
    "test:i18n:phase2:2c": "pnpm test:i18n && node ../docs/i18n/scripts/audit-phase2.mjs .. --batch=2C",
    "test:i18n:phase2:2d": "pnpm test:i18n && node ../docs/i18n/scripts/audit-phase2.mjs .. --batch=2D",
    "test:i18n:phase2:2e": "pnpm test:i18n && node ../docs/i18n/scripts/audit-phase2.mjs .. --batch=2E",
    "test:i18n:phase2:2f": "pnpm test:i18n && node ../docs/i18n/scripts/audit-phase2.mjs .. --batch=2F",
    "release:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-community-release.ps1"
  },
